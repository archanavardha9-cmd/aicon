NODE_ENV=development
PORT=3001
TRUST_PROXY_HOPS=0
DATABASE_URL=./data/aicon.sqlite
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Leave the SMTP values below blank until credentials are configured.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false.
# Enquiries are saved and email jobs remain queued while SMTP is not configured.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
BUSINESS_NOTIFICATION_EMAIL=

# Gmail requires Google Account 2-Step Verification and an App Password.
# Put the App Password in SMTP_PASS, never your regular Gmail password.
