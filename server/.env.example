# =============================================================================
# AICON Smart Appliances - Server Environment Configuration
# =============================================================================
# Copy this file to .env and replace placeholder values with your own.
# Never commit .env to version control. .env is already in .gitignore.

# --- Server ---
# Node.js environment: development, test, or production
NODE_ENV=development

# Port the Express API listens on (default: 3001)
PORT=3001

# Number of trusted reverse proxy hops (0 to 5). Set to match your deployment topology.
TRUST_PROXY_HOPS=0

# --- Database ---
# SQLite database path (relative to server/ directory). Used as degraded fallback
# when MONGODB_URI is not set, or if MongoDB connection fails.
DATABASE_URL=./data/aicon.sqlite

# MongoDB connection string (required for MERN stack).
# Example: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/aicon?retryWrites=true&w=majority
# Get this from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Leave blank to use SQLite fallback (not recommended for production).
MONGODB_URI=

# --- CORS ---
# Comma-separated list of allowed browser origins for the API.
# In development: http://localhost:5173,http://127.0.0.1:5173
# In production: add your deployed frontend origin (e.g. https://aicon-client.vercel.app)
# The frontend origin MUST be listed here or CORS will block all requests.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- SMTP (Optional) ---
# Leave all SMTP values blank until you have real credentials.
# When blank, enquiries are saved but email delivery remains queued until SMTP is configured.
# When configured, ALL SMTP fields AND BUSINESS_NOTIFICATION_EMAIL must be set.
# Partial SMTP configuration will prevent the server from starting.

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
BUSINESS_NOTIFICATION_EMAIL=

# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-address@gmail.com
#   SMTP_PASS=your-app-password (not your regular Gmail password)
#   SMTP_FROM_EMAIL=your-address@gmail.com
#   BUSINESS_NOTIFICATION_EMAIL=business@example.com
#
# Gmail requires 2-Step Verification and an App Password.
