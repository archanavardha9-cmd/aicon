# AICON Smart Appliances - Client Environment Configuration
# Copy this file to .env and replace placeholder values with your own.
# Never commit .env to version control. .env is already in .gitignore.

# Base URL for the AICON API.
# In development, Vite proxies /api to http://127.0.0.1:3001 (see vite.config.js).
# In production, set this to your API origin (e.g. https://api.example.com/api).
VITE_API_BASE_URL=/api
